use std::fs

struct IntcodeComputer {
    memory: Vec<i64>
    position: i64
    last_output: i64
    inputs: Vec<i64>
    input_position: i64
    halted: bool
}

impl IntcodeComputer {
    fn new(program: Vec<i64>) -> Self {
        IntcodeComputer {
            memory: program.clone()
            position: 0
            last_output: 0
            inputs: Vec::new()
            input_position: 0
            halted: false
        }
    }

    fn get_parameter_modes(self, instruction: i64) -> Vec<i64> {
        let mut modes = Vec::from([0; 3])
        let mut mode_bits = instruction / 100
        for i in 0..3 {
            modes[i] = mode_bits % 10
            mode_bits /= 10
        }
        modes
    }

    fn get_param(self, offset: i64, modes: Vec<i64>) -> i64 {
        let value = self.memory[self.position + offset]
        match modes[offset - 1] {
            0 => self.read_memory(value) // position mode
            1 => value                   // immediate mode
            _ => panic!("Unknown parameter mode")
        }
    }

    fn read_memory(self, addr: i64) -> i64 {
        if addr >= 0 && addr < self.memory.len() {
            self.memory[addr]
        } else {
            0
        }
    }

    fn set_memory(&mut self, offset: i64, value: i64) {
        let pos = self.memory[self.position + offset]
        while self.memory.len() < pos + 1 {
            self.memory.push(0)
        }
        self.memory[pos] = value
    }

    fn run(&mut self, new_inputs: Vec<i64>) -> i64 {
        // Add new inputs to existing inputs
        self.inputs.extend(new_inputs)

        while self.position < self.memory.len() {
            let instruction = self.memory[self.position]
            let opcode = instruction % 100
            let modes = self.get_parameter_modes(instruction)

            match opcode {
                99 => {
                    self.halted = true
                    break
                }
                1 => {
                    let sum = self.get_param(1, modes) + self.get_param(2, modes)
                    self.set_memory(3, sum)
                    self.position += 4
                }
                2 => {
                    let product = self.get_param(1, modes) * self.get_param(2, modes)
                    self.set_memory(3, product)
                    self.position += 4
                }
                3 => {
                    if self.input_position >= self.inputs.len() {
                        break; // Stop execution but don't halt
                    }
                    self.set_memory(1, self.inputs[self.input_position])
                    self.input_position += 1
                    self.position += 2
                }
                4 => {
                    self.last_output = self.get_param(1, modes)
                    self.position += 2
                }
                5 => {
                    if self.get_param(1, modes) != 0 {
                        self.position = self.get_param(2, modes)
                    } else {
                        self.position += 3
                    }
                }
                6 => {
                    if self.get_param(1, modes) == 0 {
                        self.position = self.get_param(2, modes)
                    } else {
                        self.position += 3
                    }
                }
                7 => {
                    let value = if self.get_param(1, modes) < self.get_param(2, modes) {
                        1
                    } else {
                        0
                    }
                    self.set_memory(3, value)
                    self.position += 4
                }
                8 => {
                    let value = if self.get_param(1, modes) == self.get_param(2, modes) {
                        1
                    } else {
                        0
                    }
                    self.set_memory(3, value)
                    self.position += 4
                }
                _ => panic!("Unknown opcode: {}", opcode)
            }
        }
        self.last_output
    }

    fn is_halted(self) -> bool {
        self.halted
    }
}

fn run_amplifier_sequence(program: Vec<i64>, phase_settings: Vec<i64>) -> i64 {
    let mut signal = 0

    // Run each amplifier in sequence
    for phase in phase_settings {
        let mut computer = IntcodeComputer::new(program)
        signal = computer.run(Vec::from([phase, signal]))
    }

    signal
}

fn run_amplifier_feedback_loop(program: Vec<i64>, phase_settings: Vec<i64>) -> i64 {
    let mut amplifiers = Vec::from([IntcodeComputer::new(program); 5])

    // Initialize first amplifier separately
    let mut signal = amplifiers[0].run(Vec::from([phase_settings[0], 0]))

    // Initialize remaining amplifiers
    for i in 1..5 {
        signal = amplifiers[i].run(Vec::from([phase_settings[i], signal]))
    }

    let mut final_amplifier_output = signal

    // Continue running until all amplifiers halt
    loop {
        for i in 0..5 {
            if amplifiers[i].is_halted() {
                continue
            }

            signal = amplifiers[i].run(Vec::from([signal]))
            if i == 4 {
                final_amplifier_output = signal
            }
        }

        if amplifiers.all(|amp| amp.is_halted()) {
            break
        }
    }

    final_amplifier_output
}

fn permutations(xs: Vec<i64>) -> Vec<Vec<i64>> {
    if xs.len() <= 1 {
        return Vec::from([xs])
    }
    let mut result = Vec::new()
    for i in 0..xs.len() {
        let mut rest = xs.clone()
        let Ok(_) = rest.remove(i)
        for p in permutations(rest) {
            let mut perm = Vec::from([xs[i]])
            perm.extend(p)
            result.push(perm)
        }
    }
    result
}

fn find_max_thruster_signal(
    program: Vec<i64>
    phase_range: Vec<i64>
    run_amplifiers: fn(Vec<i64>, Vec<i64>) -> i64
) -> i64 {
    permutations(phase_range)
        .map(|phase_settings| run_amplifiers(program, phase_settings))
        .max()
        .unwrap_or(0)
}

fn solve_part1(program: Vec<i64>) -> i64 {
    find_max_thruster_signal(program, Vec::from([0, 1, 2, 3, 4]), run_amplifier_sequence)
}

fn solve_part2(program: Vec<i64>) -> i64 {
    find_max_thruster_signal(program, Vec::from([5, 6, 7, 8, 9]), run_amplifier_feedback_loop)
}

fn main() {
    let input = fs::read_to_string("../input/d07.txt").unwrap()
    // let input = "3,52,1001,52,-5,52,3,53,1,52,56,54,1007,54,5,55,1005,55,26,1001,54,-5,54,1105,1,12,1,53,54,53,1008,54,0,55,1001,55,1,55,2,53,55,53,4,53,1001,56,-1,56,1005,56,6,99,0,0,0,0,10"

    let program: Vec<i64> = input
        .trim()
        .split(',')
        .map(|x| x.parse::<i64>().unwrap())

    let max_signal_part1 = solve_part1(program)
    println!("Part 1 - Maximum thruster signal: {}", max_signal_part1)

    let max_signal_part2 = solve_part2(program)
    println!("Part 2 - Maximum thruster signal with feedback loop: {}", max_signal_part2)
}
