use std::fs
use "example.com/intcode"

const DIRS: [i64; 4] = [1, 2, 3, 4]

fn parse_input(input: String) -> Vec<i64> {
    input.trim().split(',').map(|s| s.to_i64().unwrap())
}

fn reverse(cmd: i64) -> i64 {
    match cmd {
        1 => 2
        2 => 1
        3 => 4
        4 => 3
        _ => panic!("unknown movement command {}", cmd)
    }
}

fn delta(cmd: i64) -> (i64, i64) {
    match cmd {
        1 => (0, -1)
        2 => (0, 1)
        3 => (-1, 0)
        4 => (1, 0)
        _ => panic!("unknown movement command {}", cmd)
    }
}

fn explore(
    computer: &mut intcode::IntcodeComputer
    pos: (i64, i64)
    open: &mut Set<(i64, i64)>
    visited: &mut Set<(i64, i64)>
    oxygen: &mut Option<(i64, i64)>
) {
    for cmd in DIRS {
        let (dx, dy) = delta(cmd)
        let next = (pos.0 + dx, pos.1 + dy)
        if visited.contains(next) {
            continue
        }
        let status = computer.run(&[cmd])
        visited.insert(next)
        match status {
            0 => ()
            1 | 2 => {
                open.insert(next)
                if status == 2 {
                    *oxygen = Some(next)
                }
                explore(computer, next, open, visited, oxygen)
                let _ = computer.run(&[reverse(cmd)])
            }
            _ => panic!("unknown status code {}", status)
        }
    }
}

fn shortest_path(open: Set<(i64, i64)>, start: (i64, i64), target: (i64, i64)) -> i64 {
    let mut dist: Map<(i64, i64), i64> = Map::new()
    let mut frontier: Vec<(i64, i64)> = #[start]
    let mut head = 0
    dist.insert(start, 0)
    while head < frontier.len() {
        let pos = frontier[head]
        head += 1
        let d = dist.get(pos).unwrap()
        if pos == target {
            return d
        }
        for cmd in DIRS {
            let (dx, dy) = delta(cmd)
            let next = (pos.0 + dx, pos.1 + dy)
            if open.contains(next) && !dist.contains(next) {
                dist.insert(next, d + 1)
                frontier.push(next)
            }
        }
    }
    panic!("oxygen system unreachable")
}

fn fill_time(open: Set<(i64, i64)>, start: (i64, i64)) -> i64 {
    let mut dist: Map<(i64, i64), i64> = Map::new()
    let mut frontier: Vec<(i64, i64)> = #[start]
    let mut head = 0
    let mut max_d = 0
    dist.insert(start, 0)
    while head < frontier.len() {
        let pos = frontier[head]
        head += 1
        let d = dist.get(pos).unwrap()
        if d > max_d {
            max_d = d
        }
        for cmd in DIRS {
            let (dx, dy) = delta(cmd)
            let next = (pos.0 + dx, pos.1 + dy)
            if open.contains(next) && !dist.contains(next) {
                dist.insert(next, d + 1)
                frontier.push(next)
            }
        }
    }
    max_d
}

fn main() {
    let input = fs::read_to_string("../input/d15.txt").unwrap()
    let program = parse_input(input)
    let mut computer = intcode::IntcodeComputer::new(program)

    let mut open: Set<(i64, i64)> = Set::new()
    let mut visited: Set<(i64, i64)> = Set::new()
    let mut oxygen: Option<(i64, i64)> = None
    open.insert((0, 0))
    visited.insert((0, 0))
    explore(&mut computer, (0, 0), &mut open, &mut visited, &mut oxygen)

    let target = oxygen.unwrap()
    let part1 = shortest_path(open, (0, 0), target)
    println!("Part 1 - Fewest movement commands: {}", part1)

    let part2 = fill_time(open, target)
    println!("Part 2 - Minutes to fill area: {}", part2)
}
