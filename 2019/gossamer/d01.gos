use std::fs

fn parse_input(path: String) -> Vec<i64> {
    fs::read_to_string(path).unwrap()
        .lines().map(|line| line.parse::<i64>().unwrap())
}

fn fuel_one(mass: i64) -> i64 {
    mass / 3 - 2
}

fn fuel_rec(mass: i64) -> i64 {
    let mut total = 0
    let mut current_mass = mass

    while current_mass > 0 {
        let fuel = fuel_one(current_mass) |> max(0)
        total += fuel
        current_mass = fuel
    }

    total
}

fn main() {
    let modules = parse_input("../input/d01.txt")

    let part1 = modules.map(fuel_one).sum()
    let part2 = modules.map(fuel_rec).sum()

    println!("Part 1: {}", part1)
    println!("Part 2: {}", part2)
}
