use std::fs

const DIRS: [(i64, i64); 4] = [(-1, 0), (1, 0), (0, -1), (0, 1)]

struct Maze {
    start: (i64, i64)
    end: (i64, i64)
    // partner tile plus the level change stepping through causes:
    // -1 out through an outer-rim label,
    // +1 in through an inner-rim label
    warp: Map<(i64, i64), ((i64, i64), i64)>
}

fn parse_grid(input: String) -> Vec<Vec<char>> {
    input.lines().map(|line| line.chars().collect())
}

fn is_letter(ch: char) -> bool {
    ch >= 'A' && ch <= 'Z'
}

// The label beside a passage tile is the two letter cells on one side of it,
// read in reading order: left/right pairs go left to right,
// upper/lower pairs go top to bottom. 
// (dr, dc) points from the tile toward the letters;
// moving against the reading direction puts the farther cell first.
fn label_toward(grid: Vec<Vec<char>>, r: i64, c: i64, dr: i64, dc: i64) -> Option<String> {
    let fr, fc = r + 2 * dr, c + 2 * dc
    let nr, nc = r + dr, c + dc
    if fr < 0 || fr >= grid.len() || fc < 0 || fc >= grid[fr].len() {
        return None
    }
    if nr < 0 || nr >= grid.len() || nc < 0 || nc >= grid[nr].len() {
        return None
    }
    let far, near = (grid[fr][fc], grid[nr][nc])
    if !is_letter(near) || !is_letter(far) {
        return None
    }
    if dr + dc < 0 {
        Some(format("{}{}", far, near))
    } else {
        Some(format("{}{}", near, far))
    }
}

// Extremes over all passage tiles. Every labelled tile sits on one of these
// rows or columns iff it is on the donut's outer rim; the rest are inner.
fn passage_bounds(grid: Vec<Vec<char>>) -> (i64, i64, i64, i64) {
    let mut minr = -1
    let mut maxr = -1
    let mut minc = -1
    let mut maxc = -1
    for r in 0..grid.len() {
        for c in 0..grid[r].len() {
            if grid[r][c] != '.' {
                continue
            }
            if minr < 0 || r < minr {
                minr = r
            }
            if r > maxr {
                maxr = r
            }
            if minc < 0 || c < minc {
                minc = c
            }
            if c > maxc {
                maxc = c
            }
        }
    }
    (minr, maxr, minc, maxc)
}

fn parse_maze(grid: Vec<Vec<char>>) -> Maze {
    let minr, maxr, minc, maxc = passage_bounds(grid)
    let mut labels: Map<String, Vec<((i64, i64), i64)>> = Map::new()
    for r in 0..grid.len() {
        for c in 0..grid[r].len() {
            if grid[r][c] != '.' {
                continue
            }
            for (dr, dc) in DIRS {
                if let Some(name) = label_toward(grid, r, c, dr, dc) {
                    let outer = r == minr || r == maxr || c == minc || c == maxc
                    let delta = if outer { -1 } else { 1 }
                    labels.or_insert(name, #[]).push(((r, c), delta))
                }
            }
        }
    }

    let start = labels.pop("AA").unwrap()[0].0
    let end = labels.pop("ZZ").unwrap()[0].0

    let mut warp: Map<(i64, i64), ((i64, i64), i64)> = Map::new()
    for (_, ends) in labels {
        if ends.len() == 2 {
            let (a, da), (b, db) = (ends[0], ends[1])
            warp.insert(a, (b, da))
            warp.insert(b, (a, db))
        }
    }
    Maze { start: start, end: end, warp: warp }
}

// Plain BFS over passage tiles: each move is one step to a walkable
// neighbour, or one step through a portal to its partner tile.
fn fewest_steps(grid: Vec<Vec<char>>, maze: Maze) -> i64 {
    let mut seen: Set<(i64, i64)> = Set::new()
    let mut queue: Queue<((i64, i64), i64)> = Queue::new()
    seen.insert(maze.start)
    queue.push((maze.start, 0))
    while let Some((pos, dist)) = queue.pop() {
        if pos == maze.end {
            return dist
        }
        let mut moves: Vec<(i64, i64)> = #[]
        for (dr, dc) in DIRS {
            let next = (pos.0 + dr, pos.1 + dc)
            if grid[next.0][next.1] == '.' {
                moves.push(next)
            }
        }
        if let Some(jump) = maze.warp.get(pos) {
            moves.push(jump.0)
        }
        for next in moves {
            if !seen.contains(next) {
                seen.insert(next)
                queue.push((next, dist + 1))
            }
        }
    }
    panic("ZZ is unreachable from AA")
}

// Recursive-space BFS over (tile, level): walking stays on the level,
// warping inward climbs one copy of the maze and warping outward drops one,
// but never below the outermost level 0 - there an outer portal is a wall.
// AA starts on level 0 and only ZZ on level 0 is the exit.
fn recursive_steps(grid: Vec<Vec<char>>, maze: Maze) -> Option<i64> {
    let mut seen: Set<(i64, i64, i64)> = Set::new()
    let mut queue: Queue<((i64, i64, i64), i64)> = Queue::new()
    seen.insert((maze.start.0, maze.start.1, 0))
    queue.push(((maze.start.0, maze.start.1, 0), 0))
    while let Some((state, dist)) = queue.pop() {
        let r, c, level = state
        if (r, c) == maze.end && level == 0 {
            return Some(dist)
        }
        let mut moves: Vec<((i64, i64), i64)> = #[]
        for (dr, dc) in DIRS {
            let next = (r + dr, c + dc)
            if grid[next.0][next.1] == '.' {
                moves.push((next, level))
            }
        }
        if let Some((dest, delta)) = maze.warp.get((r, c)) {
            let next_level = level + delta
            if next_level >= 0 {
                moves.push((dest, next_level))
            }
        }
        for (next, next_level) in moves {
            let state = (next.0, next.1, next_level)
            if !seen.contains(state) {
                seen.insert(state)
                queue.push((state, dist + 1))
            }
        }
    }
    None
}

fn main() {
    let input = fs::read_to_string("../input/d20.txt").unwrap()
    let grid = parse_grid(input)

    let maze = parse_maze(grid)
    println("Part 1: {}", fewest_steps(grid, maze))
    println("Part 2: {}", recursive_steps(grid, maze).unwrap())
}
