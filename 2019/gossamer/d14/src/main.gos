use std::fs

struct Reaction {
    quantity: i64
    ingredients: Map<String, i64>
}

fn parse_input(input: String) -> Map<String, Reaction> {
    Map::from(
        input.lines().map(|line| {
            let (ingredients_str, output_str) = line.split(" => ")
            let (out_qty, out_name) = output_str.split(" ")
            let ingredient_parts: Vec<String> = ingredients_str.split(", ")
            let ingredients = Map::from(
                ingredient_parts.map(|ingredient| {
                    let (ing_qty, ing_name) = ingredient.split(" ")
                    (ing_name, ing_qty.to_i64().unwrap())
                })
            )
            (out_name, Reaction { quantity: out_qty.to_i64().unwrap(), ingredients: ingredients })
        })
    )
}

fn any_needed(needed: Map<String, i64>) -> Option<String> {
    needed
        .find(|(name, quantity)| name != "ORE" && quantity > 0)
        .map(|(name, _)| name)
}

fn update_ingredients_needed(
    needed: &mut Map<String, i64>
    ingredient: String
    reactions: Map<String, Reaction>
) {
    let reaction = reactions.get(ingredient).unwrap()
    let needed_qty = needed.get(ingredient).unwrap()
    let batches = needed_qty / reaction.quantity + if needed_qty % reaction.quantity != 0 { 1 } else { 0 }

    needed.insert(ingredient, needed_qty - batches * reaction.quantity)
    for (name, qty) in reaction.ingredients {
        let existing = needed.get_or(name, 0)
        needed.insert(name, existing + batches * qty)
    }
}

fn ore_for_fuel(reactions: Map<String, Reaction>, fuel_qty: i64) -> i64 {
    let mut needed: Map<String, i64> = { "FUEL": fuel_qty }
    while let Some(ingredient) = any_needed(needed) {
        update_ingredients_needed(&mut needed, ingredient, reactions)
    }
    needed.get("ORE").unwrap()
}

fn max_fuel_for_ore(reactions: Map<String, Reaction>, have_ore: i64) -> i64 {
    let mut lo = 1
    let mut hi = 1
    while ore_for_fuel(reactions, hi) <= have_ore {
        hi *= 2
    }
    while lo + 1 < hi {
        let mid = (lo + hi) / 2
        if ore_for_fuel(reactions, mid) <= have_ore {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

fn main() {
    let input = fs::read_to_string("../input/d14.txt").unwrap()
    let reactions = parse_input(input)

    let part1 = ore_for_fuel(reactions, 1)
    println!("Part 1 - ORE: {}", part1)

    let have_ore = 1_000_000_000_000
    let part2 = max_fuel_for_ore(reactions, have_ore)
    println!("Part 2 - FUEL: {}", part2)
}
