use std::fs

fn parse_input(path: String) -> Vec<i64> {
    fs::read_to_string(path).unwrap()
        .trim().split(',').map(|s| s.to_i64().unwrap())
}

fn program_step(program: &mut [i64], pos: i64, op: i64) {
    let p1 = program[pos + 1]
    let p2 = program[pos + 2]
    let tg = program[pos + 3]
    match op {
        1 => program[tg] = program[p1] + program[p2]
        2 => program[tg] = program[p1] * program[p2]
        _ => panic!("Unknown opcode encountered!")
    }
}

fn run_intcode(program: Vec<i64>, v1: i64, v2: i64) -> i64 {
    let mut program = program
    program[1] = v1
    program[2] = v2

    let mut pos = 0

    while pos < program.len() {
        match program[pos] {
            99 => break
            op => program_step(&mut program, pos, op)
        }
        pos += 4
    }

    program[0]
}

fn solve_part1(program: Vec<i64>) -> i64 {
    run_intcode(program, 12, 2)
}

fn solve_part2(program: Vec<i64>) -> Option<i64> {
    const TARGET: i64 = 19_690_720

    for noun in 0..=99 {
        for verb in 0..=99 {
            let mut code = run_intcode(program, noun, verb)
            if code == TARGET {
                return Some(100 * noun + verb)
            }
        }
    }
    None
}

fn main() {
    let program = parse_input("../input/d02.txt")

    let part1 = solve_part1(program)
    println!("Part 1: Value at position 0: {}", part1)

    let part2 = solve_part2(program)
    println!("Part 2: 100 * noun + verb = {}", part2.unwrap_or(-1))
}
