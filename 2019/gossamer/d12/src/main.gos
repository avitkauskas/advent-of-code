use std::fs

struct Vec3 { x: i64, y: i64, z: i64 }
struct Moon { pos: Vec3, vel: Vec3 }

fn parse_moons(input: String) -> Vec<Moon> {
    let mut moons: Vec<Moon> = #[]
    for line in input.trim().lines() {
        let coords = line.split(',')
            .map(|p| p.trim_matches("<> xyz=").to_i64().unwrap())

        moons.push(Moon {
            pos: Vec3 { x: coords[0], y: coords[1], z: coords[2] }
            vel: Vec3 { x: 0, y: 0, z: 0 }
        })
    }
    moons
}

fn pull(p: i64, q: i64) -> i64 {
    if p < q { 1 } else if p > q { -1 } else { 0 }
}

fn gravity(a: Vec3, b: Vec3) -> (Vec3, Vec3) {
    (
        Vec3 { x: pull(a.x, b.x), y: pull(a.y, b.y), z: pull(a.z, b.z) }
        Vec3 { x: pull(b.x, a.x), y: pull(b.y, a.y), z: pull(b.z, a.z) }
    )
}

fn apply_gravity(moons: &mut [Moon]) {
    let n = moons.len()
    for i in ..n {
        for j in (i + 1)..n {
            let gi, gj = gravity(moons[i].pos, moons[j].pos)
            moons[i].vel.x += gi.x
            moons[i].vel.y += gi.y
            moons[i].vel.z += gi.z
            moons[j].vel.x += gj.x
            moons[j].vel.y += gj.y
            moons[j].vel.z += gj.z
        }
    }
}

fn apply_velocity(moons: &mut [Moon]) {
    for k in ..moons.len() {
        moons[k].pos.x += moons[k].vel.x
        moons[k].pos.y += moons[k].vel.y
        moons[k].pos.z += moons[k].vel.z
    }
}

fn simulate(steps: i64, moons: &mut [Moon]) {
    for _ in 0..steps {
        apply_gravity(moons)
        apply_velocity(moons)
    }
}

fn total_energy(moons: [Moon]) -> i64 {
    let mut sum = 0
    for m in moons {
        let pot = m.pos.x.abs() + m.pos.y.abs() + m.pos.z.abs()
        let kin = m.vel.x.abs() + m.vel.y.abs() + m.vel.z.abs()
        sum += pot * kin
    }
    sum
}

fn axis_period(start_pos: [i64; 4], start_vel: [i64; 4]) -> i64 {
    let mut p, mut v = (start_pos, start_vel)
    let mut n: i64 = 0
    loop {
        for i in ..4 {
            for j in (i + 1)..4 {
                v[i] += pull(p[i], p[j])
                v[j] += pull(p[j], p[i])
            }
        }
        for k in ..4 {
            p[k] += v[k]
        }
        n += 1
        if p == start_pos && v == start_vel {
            return n
        }
    }
}

fn gcd(a: i64, b: i64) -> i64 {
    let mut x, mut y = (a.abs(), b.abs())
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    x
}

fn lcm(a: i64, b: i64) -> i64 {
    a / gcd(a, b) * b
}

fn main() {
    let input = fs::read_to_string("../input/d12.txt").unwrap()
    let mut moons = parse_moons(input)

    let px = [moons[0].pos.x, moons[1].pos.x, moons[2].pos.x, moons[3].pos.x]
    let py = [moons[0].pos.y, moons[1].pos.y, moons[2].pos.y, moons[3].pos.y]
    let pz = [moons[0].pos.z, moons[1].pos.z, moons[2].pos.z, moons[3].pos.z]

    simulate(1000, &mut moons)
    println("Part 1: {}", total_energy(moons))

    let x = axis_period(px, [0; 4])
    let y = axis_period(py, [0; 4])
    let z = axis_period(pz, [0; 4])
    println("Part 2: {}", lcm(x, lcm(y, z)))
}
