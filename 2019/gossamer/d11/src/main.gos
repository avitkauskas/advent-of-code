use std::fs
use "example.com/intcode"

fn parse_input(path: String) -> Vec<i64> {
    fs::read_to_string(path).unwrap()
        .trim().split(',').map(|s| s.to_i64().unwrap())
}

fn paint(program: Vec<i64>, start_color: i64) -> (i64, Map<(i64, i64), i64>) {
    let mut computer = intcode::IntcodeComputer::new(program)
    let mut pos = (0, 0)
    let mut dir = 0
    let mut panels: Map<(i64, i64), i64> = {}
    let mut consumed = 0

    panels.insert(pos, start_color)

    loop {
        let color = panels.get_or(pos, 0)
        computer.run([color])

        if computer.output_count() == consumed {
            break
        }

        let paint_color = computer.output(consumed)
        let turn = computer.output(consumed + 1)
        consumed += 2

        panels.insert(pos, paint_color)

        dir = match turn {
            0 => (dir + 3) % 4
            1 => (dir + 1) % 4
            _ => unreachable()
        }

        match dir {
            0 => pos.1 += 1
            1 => pos.0 += 1
            2 => pos.1 -= 1
            3 => pos.0 -= 1
            _ => unreachable()
        }

        if computer.is_halted() {
            break
        }
    }

    (panels.len(), panels)
}

fn render(panels: Map<(i64, i64), i64>) {
    let mut min_x = 0
    let mut max_x = 0
    let mut min_y = 0
    let mut max_y = 0
    for (x, y) in panels.keys() {
        min_x = min_x.min(x)
        max_x = max_x.max(x)
        min_y = min_y.min(y)
        max_y = max_y.max(y)
    }

    for y in (min_y..=max_y).rev() {
        let line = (min_x..=max_x)
            .map(|x| if panels.get_or((x, y), 0) == 1 { "#" } else { " " })
            .collect()
            .join("")
        println("{}", line)
    }
}

fn main() {
    let program = parse_input("../input/d11.txt")

    // Part 1 - starting on a black panel
    let count, _ = paint(program, 0)
    println("Part 1 - Panels painted at least once: {}", count)

    // Part 2 - starting on a white panel
    let _, panels = paint(program, 1)
    println("Part 2 - Registration identifier:")
    render(panels)
}
