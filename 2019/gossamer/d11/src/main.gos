use std::fs

fn parse_input(path: String) -> Vec<i64> {
    fs::read_to_string(path).unwrap()
        .trim().split(',').map(|s| s.parse::<i64>().unwrap())
}

// Run the painting robot. `start_color` is the color of the starting panel
// (0 for part 1, 1 for part 2). Returns the number of panels painted at
// least once, the painted positions, and the final panel colors.
fn paint(program: Vec<i64>, start_color: i64) -> (i64, Vec<(i64, i64)>, Map<(i64, i64), i64>) {
    let mut computer = intcode::IntcodeComputer::new(program)
    let mut pos = (0, 0)
    let mut dir = 0
    let mut panels: Map<(i64, i64), i64> = {}
    let mut coords: Vec<(i64, i64)> = #[]
    let mut consumed = 0

    panels.insert(pos, start_color)
    coords.push(pos)

    loop {
        let color = panels.get_or(pos, 0)
        computer.run(&[color])

        if computer.output_count() == consumed {
            break
        }

        let paint_color = computer.output(consumed)
        let turn = computer.output(consumed + 1)
        consumed += 2

        panels.insert(pos, paint_color)
        coords.push(pos)

        if turn == 0 {
            dir = (dir + 3) % 4
        } else {
            dir = (dir + 1) % 4
        }

        match dir {
            0 => pos.1 += 1
            1 => pos.0 += 1
            2 => pos.1 -= 1
            3 => pos.0 -= 1
            _ => unreachable!()
        }

        if computer.is_halted() {
            break
        }
    }

    (panels.len(), coords, panels)
}

fn render(coords: Vec<(i64, i64)>, panels: Map<(i64, i64), i64>) {
    let mut min_x = 0
    let mut max_x = 0
    let mut min_y = 0
    let mut max_y = 0
    for p in coords {
        min_x = min_x.min(p.0)
        max_x = max_x.max(p.0)
        min_y = min_y.min(p.1)
        max_y = max_y.max(p.1)
    }

    for y in (min_y..=max_y).rev() {
        let mut line = String::new()
        let mut x = min_x
        while x <= max_x {
            if panels.get_or((x, y), 0) == 1 {
                line += "#"
            } else {
                line += " "
            }
            x += 1
        }
        println!("{}", line)
    }
}

fn main() {
    let program = parse_input("../input/d11.txt")

    // Part 1 - starting on a black panel
    let (count, _, _) = paint(program, 0)
    println!("Part 1 - Panels painted at least once: {}", count)

    // Part 2 - starting on a white panel
    let (_, coords, panels) = paint(program, 1)
    println!("Part 2 - Registration identifier:")
    render(coords, panels)
}
