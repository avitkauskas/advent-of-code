use std::fs

const DIRS: [(i64, i64); 4] = [(-1, 0), (1, 0), (0, -1), (0, 1)]


fn parse_level(input: String) -> [bool; 25] {
    let mut grid: [bool; 25] = [false; 25]
    let mut i = 0
    for ch in input.trim().chars() {
        if ch == '\n' {
            continue
        }
        grid[i] = ch == '#'
        i += 1
    }
    grid[12] = false
    grid
}

fn count_adjacent(grid: [bool; 25], idx: i64) -> i64 {
    let r = idx / 5
    let c = idx % 5
    let mut count = 0
    for (dr, dc) in DIRS {
        let nr = r + dr
        let nc = c + dc
        if nr >= 0 && nr < 5 && nc >= 0 && nc < 5 && grid[(nr * 5 + nc) as i64] {
            count += 1
        }
    }
    count
}

fn step(grid: [bool; 25]) -> [bool; 25] {
    let mut next: [bool; 25] = [false; 25]
    for i in ..25 {
        let n = count_adjacent(grid, i)
        if grid[i] {
            next[i] = n == 1
        } else {
            next[i] = n == 1 || n == 2
        }
    }
    next
}

fn biodiversity(grid: [bool; 25]) -> i64 {
    let mut value = 0
    for i in ..25 {
        if grid[i] {
            value += 1 << i
        }
    }
    value
}

fn part1(mut grid: [bool; 25]) -> i64 {
    let mut seen: Set<i64> = #{}
    loop {
        let value = biodiversity(grid)
        if seen.contains(value) {
            return value
        }
        seen.insert(value)
        grid = step(grid)
    }
}

fn cell(grids: Map<i64, [bool; 25]>, level: i64, r: i64, c: i64) -> bool {
    if let Some(g) = grids.get(level) {
        g[r * 5 + c]
    } else {
        false
    }
}

fn bug_count(grids: Map<i64, [bool; 25]>, level: i64, r: i64, c: i64) -> i64 {
    let mut positions: Vec<(i64, i64, i64)> = #[]
    for (dr, dc) in DIRS {
        let nr = r + dr
        let nc = c + dc
        if nr == 2 && nc == 2 {
            continue
        }
        if nr >= 0 && nr < 5 && nc >= 0 && nc < 5 {
            positions.push((level, nr, nc))
        }
    }
    if r == 1 && c == 2 {
        for cc in ..5 {
            positions.push((level + 1, 0, cc))
        }
    }
    if r == 3 && c == 2 {
        for cc in ..5 {
            positions.push((level + 1, 4, cc))
        }
    }
    if r == 2 && c == 1 {
        for cr in ..5 {
            positions.push((level + 1, cr, 0))
        }
    }
    if r == 2 && c == 3 {
        for cr in ..5 {
            positions.push((level + 1, cr, 4))
        }
    }
    if r == 0 {
        positions.push((level - 1, 1, 2))
    }
    if r == 4 {
        positions.push((level - 1, 3, 2))
    }
    if c == 0 {
        positions.push((level - 1, 2, 1))
    }
    if c == 4 {
        positions.push((level - 1, 2, 3))
    }
    positions.count(|(lev, nr, nc)| cell(grids, lev, nr, nc))
}

fn count_bugs(grids: Map<i64, [bool; 25]>) -> i64 {
    let mut total = 0
    for (_, g) in grids {
        total += g.count_of(true)
    }
    total
}

fn step_all(grids: Map<i64, [bool; 25]>) -> Map<i64, [bool; 25]> {
    let keys = grids.keys()
    let min = keys.min().unwrap()
    let max = keys.max().unwrap()

    let mut next: Map<i64, [bool; 25]> = {}
    for level in (min - 1)..=(max + 1) {
        let mut ng: [bool; 25] = [false; 25]
        for i in ..25 {
            let r = i / 5
            let c = i % 5
            let bug = cell(grids, level, r, c)
            if r == 2 && c == 2 {
                continue
            }
            let n = bug_count(grids, level, r, c)
            if bug {
                ng[i] = n == 1
            } else {
                ng[i] = n == 1 || n == 2
            }
        }
        if ng.any(|b| b) {
            next.insert(level, ng)
        }
    }
    next
}

fn part2(level0: [bool; 25]) -> i64 {
    let mut grids: Map<i64, [bool; 25]> = {}
    grids.insert(0, level0)
    for _ in ..200 {
        grids = step_all(grids)
    }
    count_bugs(grids)
}

fn main() {
    let input = fs::read_to_string("../input/d24.txt").unwrap()
    let level0 = parse_level(input)

    println("part 1: {}", part1(level0))
    println("part 2: {}", part2(level0))
}
