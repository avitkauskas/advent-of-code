pub struct IntcodeComputer {
    memory: Map<i64, i64>
    position: i64
    relative_base: i64
    last_output: i64
    outputs: Vec<i64>
    inputs: Vec<i64>
    input_position: i64
    halted: bool
    lastpos: i64
}

impl IntcodeComputer {
    pub fn new(program: Vec<i64>) -> Self {
        let mut memory = Map::new()
        for (addr, value) in program.enumerate() {
            memory.insert(addr, value)
        }
        IntcodeComputer {
            memory: memory
            position: 0
            relative_base: 0
            last_output: 0
            outputs: #[]
            inputs: #[]
            input_position: 0
            halted: false
            lastpos: -1
        }
    }

    fn get_parameter_modes(self, instruction: i64) -> [i64; 3] {
        let mut modes = [0; 3]
        let mut mode_bits = instruction / 100
        for i in 0..3 {
            modes[i] = mode_bits % 10
            mode_bits /= 10
        }
        modes
    }

    fn get_param(self, offset: i64, modes: [i64; 3]) -> i64 {
        let value = self.read_memory(self.position + offset)
        match modes[offset - 1] {
            0 => self.read_memory(value)
            1 => value
            2 => self.read_memory(value + self.relative_base)
            _ => panic("Unknown parameter mode: {}", modes[offset - 1])
        }
    }

    fn read_memory(self, addr: i64) -> i64 {
        if addr < 0 {
            panic("Invalid memory access at negative address {}", addr)
        }
        self.memory.get_or(addr, 0)
    }

    fn set_memory(&mut self, offset: i64, modes: [i64; 3], value: i64) -> () {
        let param = self.read_memory(self.position + offset)
        let addr = match modes[offset - 1] {
            0 => param
            2 => param + self.relative_base
            1 => panic("Cannot write in immediate mode")
            _ => panic("Unknown parameter mode: {}", modes[offset - 1])
        }
        if addr < 0 {
            panic("Invalid memory access at negative address {}", addr)
        }
        self.memory.insert(addr, value)
    }

    pub fn run(&mut self, new_inputs: [i64]) -> i64 {
        self.inputs.extend(new_inputs)
        loop {
            let instruction = self.read_memory(self.position)
            if self.position != self.lastpos {
                self.lastpos = self.position
            }
            let opcode = instruction % 100
            let modes = self.get_parameter_modes(instruction)

            match opcode {
                99 => {
                    self.halted = true
                    break
                }
                1 => {
                    let sum = self.get_param(1, modes) + self.get_param(2, modes)
                    self.set_memory(3, modes, sum)
                    self.position += 4
                }
                2 => {
                    let product = self.get_param(1, modes) * self.get_param(2, modes)
                    self.set_memory(3, modes, product)
                    self.position += 4
                }
                3 => {
                    if self.input_position >= self.inputs.len() {
                        break
                    }
                    self.set_memory(1, modes, self.inputs[self.input_position])
                    self.input_position += 1
                    self.position += 2
                }
                4 => {
                    let value = self.get_param(1, modes)
                    self.last_output = value
                    self.outputs.push(value)
                    self.position += 2
                }
                5 => {
                    if self.get_param(1, modes) != 0 {
                        self.position = self.get_param(2, modes)
                    } else {
                        self.position += 3
                    }
                }
                6 => {
                    if self.get_param(1, modes) == 0 {
                        self.position = self.get_param(2, modes)
                    } else {
                        self.position += 3
                    }
                }
                7 => {
                    let value = if self.get_param(1, modes) < self.get_param(2, modes) { 1 } else { 0 }
                    self.set_memory(3, modes, value)
                    self.position += 4
                }
                8 => {
                    let value = if self.get_param(1, modes) == self.get_param(2, modes) { 1 } else { 0 }
                    self.set_memory(3, modes, value)
                    self.position += 4
                }
                9 => {
                    self.relative_base += self.get_param(1, modes)
                    self.position += 2
                }
                _ => panic("Unknown opcode: {}", opcode)
            }
        }
        self.last_output
    }

    pub fn is_halted(&self) -> bool {
        self.halted
    }

    pub fn output_count(&self) -> i64 {
        self.outputs.len()
    }

    pub fn output(&self, index: i64) -> i64 {
        self.outputs[index]
    }

    pub fn all_outputs(&self) -> Vec<i64> {
        self.outputs
    }
}

#[cfg(test)]
mod intcode_tests {
    fn run_program(program: Vec<i64>, input: i64) -> Vec<i64> {
        let mut computer = super::IntcodeComputer::new(program)
        computer.run([input])
        computer.outputs
    }

    #[test]
    fn produces_copy_of_itself() {
        let program = #[109, 1, 204, -1, 1001, 100, 1, 100, 1008, 100, 16, 101, 1006, 101, 0, 99]
        let outputs = run_program(program, 0)
        assert(
            outputs == #[109, 1, 204, -1, 1001, 100, 1, 100, 1008, 100, 16, 101, 1006, 101, 0, 99]
            "self-copy program"
        )
    }

    #[test]
    fn outputs_sixteen_digit_number() {
        let outputs = run_program(#[1_102, 34_915_192, 34_915_192, 7, 4, 7, 99, 0], 0)
        assert(outputs == #[1_219_070_632_396_864], "16-digit output")
    }

    #[test]
    fn outputs_large_number() {
        let outputs = run_program(#[104, 1_125_899_906_842_624, 99], 0)
        assert(outputs == #[1_125_899_906_842_624], "large number output")
    }
}
